# Local dev only. For EC2 / docker compose, copy and fill apps/medusa/.env.prod
# (gitignored) — see that file for the full production variable list.

# --- Local dev (medusa develop on host, Postgres on host) ---
# Medusa tables go in public; Prisma tables (companies, stock_items, …) keep their names.
# Do not use ?schema= — Medusa v2 is not reliable with a custom schema.
DATABASE_URL="postgresql://USER@localhost:5432/tally_sync"

STORE_CORS=http://localhost:8000,http://localhost:9000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000

# On the host (medusa develop): redis://localhost:6379
# In docker compose the service overrides this to redis://redis:6379
REDIS_URL=redis://localhost:6379

# Required in production (docker image / NODE_ENV=production)
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# Optional: Medusa stock location id for Tally qty (default = first location)
# TALLY_STOCK_LOCATION_ID=sloc_...

# Production (NODE_ENV=production): S3 File Module. Local/dev keeps disk uploads.
# file_url for AWS: https://{bucket}.s3.{region}.amazonaws.com
# endpoint for AWS: https://s3.{region}.amazonaws.com (optional for standard S3)
# S3_FILE_URL=https://your-bucket.s3.ap-south-1.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=ap-south-1
# S3_BUCKET=your-bucket
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# S3_FORCE_PATH_STYLE=true  # MinIO / R2 / path-style only

