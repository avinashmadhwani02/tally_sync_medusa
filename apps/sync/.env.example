# Copy to apps/sync/.env and fill in.

# --- Tally (read-only source) ---
# The live Tally XML server, as ip:port. Tally must be running with a company open.
TALLY_HOST=192.168.1.5:9000

# --- Medusa (upload target) ---
MEDUSA_URL=http://localhost:9000
MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=change-me

# --- Sync options ---
SYNC_CURRENCY=inr
