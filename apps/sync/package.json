{
  "name": "@tally-sync/sync",
  "version": "0.1.0",
  "private": true,
  "description": "Composable Tally -> Medusa sync pipeline (fetch -> stage -> transform -> push) with durable logs",
  "scripts": {
    "sync": "node bin/sync.js",
    "fetch": "node bin/sync.js --step fetch",
    "push": "node bin/sync.js --step push",
    "push:commit": "node bin/sync.js --step push --commit",
    "test": "node --test 'src/**/*.test.js'"
  },
  "dependencies": {
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1"
  },
  "devDependencies": {}
}
